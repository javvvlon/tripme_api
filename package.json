{
  "name": "tripme_api",
  "version": "0.1.0",
  "private": true,
  "description": "TripMe API \u2014 unified tour search across suppliers. Level 1 of the concept: the agent workspace.",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc && tsc-alias && npm run copy:fixtures",
    "start": "node dist/main.js",
    "dev": "tsc --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "copy:fixtures": "mkdir -p dist/modules/suppliers/fixtures && cp src/modules/suppliers/fixtures/* dist/modules/suppliers/fixtures/"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "node-html-parser": "^9.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
