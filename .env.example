# Suppliers hit the real endpoints when this is 1. Unset or 0 replays the
# saved fixtures instead — no requests leave the machine, which is how tests
# and local work should run.
SUPPLIER_LIVE=1

PORT=3001
CORS_ORIGINS=http://localhost:3000

# --- Database (Supabase) -----------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction
# pooler" (port 6543). The pooler is the right one for a Node server: it
# multiplexes, so a handful of app connections do not exhaust the project's
# limit. The direct connection (5432) is for migrations if the pooler refuses
# DDL.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase terminates TLS, so SSL stays on unless this says otherwise. Set to 0
# only for a Postgres running on this machine.
DATABASE_SSL=1
DATABASE_POOL_MAX=5

# --- Auth --------------------------------------------------------------------
# Signs access tokens. At least 32 characters, and different per environment —
# anyone holding this can mint a token for any account, including an admin.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Short by design: an access token cannot be withdrawn once issued, so it
# expires instead. The refresh token is the revocable half.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Site cache invalidation -------------------------------------------------
# The home page is served stale-while-revalidate, so a publish would otherwise
# take up to ten minutes to appear. After every content write the API asks the
# site to drop its cached pages.
#
# Unset means "off", which is correct in development: nothing is cached there.
# The secret must match NUXT_REVALIDATE_SECRET on the frontend.
#   openssl rand -hex 32
SITE_REVALIDATE_URL=https://tripme.uz/api/revalidate
SITE_REVALIDATE_SECRET=

# --- File storage (Supabase Storage, over S3) --------------------------------
# The CMS uploads images here. Reads are public, so no key is involved; writes
# go through the API, because editors are authenticated by our own guard rather
# than by Supabase.
#
# S3 credentials rather than the service_role key on purpose: service_role
# bypasses RLS on every table in the project, which is far more authority than
# storing a picture needs. An S3 access key reaches storage and nothing else,
# and can be revoked on its own.
#   Dashboard -> Storage -> S3 -> New access key
SUPABASE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_BUCKET=tripme_content

# Public URLs are built from this; derived from DATABASE_URL when unset.
SUPABASE_URL=
